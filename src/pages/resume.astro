---
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { buttonVariants } from '@/components/ui/button'

const EXPERIENCE = [
  {
    role: "Senior Full Stack Engineeer",
    company: "Company Name",
    location: "Remote",
    period: "2023 - Present",
    description: "Leading development of high-performance web applications using React, Node.js, and TypeScript."
  },
  {
    role: "Software Developer",
    company: "Previous Tech",
    location: "Kyiv, Ukraine",
    period: "2020 - 2023",
    description: "Developed microservices architecture and improved system reliability by 99.9%."
  }
]
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Resume" description="Professional history and skills." />
  
  <div class="mb-8 flex items-center justify-between">
      <h1 class="text-3xl font-medium">Resume</h1>
      <a href="/resume.pdf" class={buttonVariants({ variant: 'outline', size: 'sm' })} target="_blank">
        Download PDF
      </a>
  </div>

  <section class="mb-12">
    <h2 class="text-xl font-medium mb-4 border-b pb-2">Experience</h2>
    <div class="space-y-8">
      {EXPERIENCE.map((job) => (
        <div class="flex flex-col sm:flex-row sm:gap-4">
            <div class="sm:w-32 shrink-0 text-sm text-muted-foreground pt-1">
                {job.period}
            </div>
            <div>
                <h3 class="font-medium text-lg">{job.role}</h3>
                <div class="text-sm text-foreground/80 mb-2">{job.company} &bull; {job.location}</div>
                <p class="text-muted-foreground text-sm max-w-prose">
                    {job.description}
                </p>
            </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mb-12">
    <h2 class="text-xl font-medium mb-4 border-b pb-2">Education</h2>
    <div class="flex flex-col sm:flex-row sm:gap-4">
        <div class="sm:w-32 shrink-0 text-sm text-muted-foreground pt-1">
            2016 - 2020
        </div>
        <div>
            <h3 class="font-medium text-lg">Bachelor of Computer Science</h3>
            <div class="text-sm text-foreground/80">University Name</div>
        </div>
    </div>
  </section>

  <section>
    <h2 class="text-xl font-medium mb-4 border-b pb-2">Skills</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        {["JavaScript / TypeScript", "React / Next.js", "Node.js", "Go", "Docker / Kubernetes", "AWS", "PostgreSQL"].map(skill => (
            <div class="text-sm p-2 bg-muted/50 rounded">{skill}</div>
        ))}
    </div>
  </section>

</Layout>

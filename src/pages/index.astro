---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import TechStack from '@/components/TechStack.astro'
import FeaturedProjects from '@/components/FeaturedProjects.astro'

const blog = await getRecentPosts(SITE.featuredPostCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  
  <section class="flex flex-col space-y-4 mb-12">
    <div class="space-y-2">
       <h1 class="text-3xl font-bold tracking-tight">John Doe</h1>
       <p class="text-xl text-muted-foreground">Software Engineer & Creative Technologist</p>
    </div>
    <p class="max-w-prose text-muted-foreground leading-relaxed">
      I build accessible, pixel-perfect, and performant web experiences. 
      Passionate about <strong>Open Source</strong>, <strong>Distributed Systems</strong>, and creating digital art.
      Currently navigating the deep seas of code.
    </p>
    <div class="flex gap-4">
        <a href="/resume" class={buttonVariants({ variant: 'default' })}>View Resume</a>
        <a href="/about" class={buttonVariants({ variant: 'outline' })}>More about me</a>
    </div>
  </section>
  
  <div class="flex flex-col gap-16">
      <TechStack />
      
      <FeaturedProjects />
     
      <section class="flex flex-col gap-y-4">
        <h2 class="text-xl font-medium">Latest Posts</h2>
        <ul class="flex flex-col gap-y-4">
          {
            blog.map((post) => (
              <li>
                <BlogCard entry={post} />
              </li>
            ))
          }
        </ul>
        <div class="flex justify-center">
          <Link
            href="/blog"
            class={buttonVariants({ variant: 'ghost' }) + ' group'}
          >
            See all posts <span
              class="ml-1.5 transition-transform group-hover:translate-x-1"
              >&rarr;</span
            >
          </Link>
        </div>
      </section>
  </div>
</Layout>

<dialog id="lightbox" data-lightbox aria-label="Image viewer">
  <figure>
    <img alt="">
    <figcaption>
      <span data-lightbox-caption></span>
      <span data-lightbox-count hidden></span>
    </figcaption>
  </figure>
  <button type="button" data-icon-button data-lightbox-close aria-label="Close">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="1.25em"
      height="1.25em"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M6 6l12 12M18 6L6 18"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
  </button>
  <button
    type="button"
    data-icon-button
    data-lightbox-nav="prev"
    aria-label="Previous image"
    hidden
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="1.5em"
      height="1.5em"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M15 5l-7 7 7 7"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
  <button
    type="button"
    data-icon-button
    data-lightbox-nav="next"
    aria-label="Next image"
    hidden
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="1.5em"
      height="1.5em"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <path
        d="M9 5l7 7-7 7"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  </button>
</dialog>

<style is:global>
  prose-content img[role="button"] {
    cursor: zoom-in;
  }

  prose-content img[role="button"]:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  #lightbox {
    touch-action: pan-y pinch-zoom;
    /* reset.css zeroes margins; a modal dialog needs auto to centre */
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: #e2e8f0;
    max-inline-size: 100vw;
    max-block-size: 100dvh;
  }

  #lightbox[open] {
    display: flex;
  }

  #lightbox::backdrop {
    background: rgb(2 6 23 / 0.88);
  }

  #lightbox figure {
    display: grid;
    justify-items: center;
    gap: var(--space-2xs);
    margin: 0;
  }

  #lightbox img {
    display: block;
    max-inline-size: 96vw;
    max-block-size: 88vh;
    object-fit: contain;
    border-radius: var(--radius-md);
    cursor: zoom-out;
    touch-action: pan-y pinch-zoom;
  }

  #lightbox figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-s);
    max-inline-size: 96vw;
    font-size: var(--step--1);
    color: #cbd5e1;
  }

  #lightbox [data-lightbox-close] {
    position: fixed;
    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
    color: #e2e8f0;
    background-color: rgb(11 16 38 / 0.6);
  }

  #lightbox [data-lightbox-close]:hover {
    background-color: rgb(11 16 38 / 0.85);
  }

  #lightbox [data-lightbox-nav] {
    position: fixed;
    inset-block-start: 50%;
    transform: translateY(-50%);
    inline-size: 2.75rem;
    block-size: 2.75rem;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    color: #e2e8f0;
    background-color: rgb(11 16 38 / 0.6);
  }

  #lightbox [data-lightbox-nav]:hover {
    background-color: rgb(11 16 38 / 0.85);
  }

  #lightbox [data-lightbox-nav][hidden] {
    display: none;
  }

  #lightbox [data-lightbox-nav="prev"] {
    inset-inline-start: var(--space-s);
  }

  #lightbox [data-lightbox-nav="next"] {
    inset-inline-end: var(--space-s);
  }

  html:has(#lightbox[open]) {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes lightbox-fade {
      from {
        opacity: 0;
      }
    }

    #lightbox[open] img {
      animation: lightbox-fade 150ms ease-out;
    }
  }
</style>

<script>
  const dialog = document.getElementById("lightbox")
  const image = dialog?.querySelector("img")
  const caption = dialog?.querySelector("[data-lightbox-caption]")
  const counter = dialog?.querySelector("[data-lightbox-count]")
  const closeButton = dialog?.querySelector("[data-lightbox-close]")
  const prevButton = dialog?.querySelector('[data-lightbox-nav="prev"]')
  const nextButton = dialog?.querySelector('[data-lightbox-nav="next"]')

  if (
    dialog instanceof HTMLDialogElement &&
    image &&
    caption &&
    counter &&
    closeButton &&
    prevButton instanceof HTMLButtonElement &&
    nextButton instanceof HTMLButtonElement
  ) {
    const selector = "prose-content img"

    const isTarget = (node: unknown): node is HTMLImageElement =>
      node instanceof HTMLImageElement &&
      node.matches(selector) &&
      !node.closest("a, bom-chart")

    const imagesIn = (root: ParentNode): HTMLImageElement[] =>
      [...root.querySelectorAll<HTMLImageElement>(selector)].filter(isTarget)

    for (const img of imagesIn(document)) {
      img.tabIndex = 0
      img.setAttribute("role", "button")
      img.setAttribute(
        "aria-label",
        img.alt ? `Enlarge image: ${img.alt}` : "Enlarge image",
      )
    }

    let group: HTMLImageElement[] = []
    let index = 0
    let opener: HTMLImageElement | null = null

    const render = () => {
      const img = group[index]
      if (!img) return
      image.setAttribute("src", img.getAttribute("src") ?? "")
      image.alt = img.alt
      caption.textContent = img.alt
      caption.toggleAttribute("hidden", !img.alt)
      counter.textContent = `${index + 1} / ${group.length}`
      counter.toggleAttribute("hidden", group.length < 2)
      prevButton.toggleAttribute("hidden", group.length < 2)
      nextButton.toggleAttribute("hidden", group.length < 2)
    }

    const open = (img: HTMLImageElement) => {
      opener = img
      group = imagesIn(img.closest("article") ?? document)
      index = Math.max(0, group.indexOf(img))
      render()
      dialog.showModal()
    }

    const step = (delta: number) => {
      if (group.length < 2) return
      index = (index + delta + group.length) % group.length
      render()
    }

    document.addEventListener("click", (event) => {
      if (isTarget(event.target)) open(event.target)
    })

    document.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        if (isTarget(event.target)) {
          event.preventDefault()
          open(event.target)
        }
        return
      }
      if (!dialog.open) return
      if (event.key === "ArrowLeft") {
        event.preventDefault()
        step(-1)
      } else if (event.key === "ArrowRight") {
        event.preventDefault()
        step(1)
      }
    })

    prevButton.addEventListener("click", () => step(-1))
    nextButton.addEventListener("click", () => step(1))

    // Touch swipe: left = next, right = previous
    const SWIPE_MIN = 50
    let startX = 0
    let startY = 0
    let tracking = false
    let swiped = false
    let swipeTimer = 0

    dialog.addEventListener("pointerdown", (event) => {
      swiped = false
      tracking = event.pointerType === "touch" && event.isPrimary
      startX = event.clientX
      startY = event.clientY
    })

    dialog.addEventListener("pointercancel", () => {
      tracking = false
    })

    dialog.addEventListener("pointerup", (event) => {
      if (!tracking) return
      tracking = false
      const dx = event.clientX - startX
      const dy = event.clientY - startY
      if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) <= Math.abs(dy)) return
      step(dx < 0 ? 1 : -1)
      // The click that follows this pointerup must not close the dialog
      swiped = true
      clearTimeout(swipeTimer)
      swipeTimer = window.setTimeout(() => {
        swiped = false
      }, 400)
    })

    dialog.addEventListener("click", (event) => {
      if (swiped) {
        swiped = false
        return
      }
      if (event.target === dialog || event.target === image) dialog.close()
    })

    closeButton.addEventListener("click", () => dialog.close())

    dialog.addEventListener("close", () => {
      opener?.focus({ preventScroll: true })
      opener = null
    })
  }
</script>

---
import { Icon } from 'astro-icon/components'

const STACK = [
  { name: 'Kubernetes', icon: 'lucide:container' },
  { name: 'Openshift', icon: 'lucide:layers' },
  { name: 'Google Anthos', icon: 'lucide:cloud' },
  { name: 'Terraform', icon: 'lucide:binary' },
  { name: 'Azure', icon: 'lucide:terminal' },
]
---
<section>
    <h2 class="text-xl font-medium mb-4">Tech Stack</h2>
    <div class="flex flex-wrap gap-4">
        {STACK.map(tech => (
            <div class="flex items-center gap-2 px-3 py-2 border rounded-lg bg-muted/30">
                <Icon name={tech.icon} class="size-5 text-primary" />
                <span class="text-sm font-medium">{tech.name}</span>
            </div>
        ))}
    </div>
</section>

---
import { Icon } from 'astro-icon/components'

const STACK = [
  { name: 'TypeScript', icon: 'lucide:file-code' },
  { name: 'React', icon: 'lucide:code' },
  { name: 'Astro', icon: 'lucide:rocket' },
  { name: 'Tailwind', icon: 'lucide:palette' },
  { name: 'PostgreSQL', icon: 'lucide:database' },
  { name: 'Docker', icon: 'lucide:container' },
  // Add more icons as available in lucide or custom
]
---
<section>
    <h2 class="text-xl font-medium mb-4">Tech Stack</h2>
    <div class="flex flex-wrap gap-4">
        {STACK.map(tech => (
            <div class="flex items-center gap-2 px-3 py-2 border rounded-lg bg-muted/30">
                <Icon name={tech.icon} class="size-5 text-primary" />
                <span class="text-sm font-medium">{tech.name}</span>
            </div>
        ))}
    </div>
</section>

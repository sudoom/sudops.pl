---
import { Icon } from 'astro-icon/components'

const STACK = [
  { name: 'Kubernetes', icon: 'logos:kubernetes' },
  { name: 'Openshift', icon: 'logos:openshift' },
  { name: 'Google Anthos', icon: 'logos:google-cloud-anthos' }, /* Or logos:google-cloud if specific anthos icon is missing */
  { name: 'Terraform', icon: 'logos:terraform-icon' },
  { name: 'Azure', icon: 'logos:microsoft-azure' },
]
---
<section>
    <h2 class="text-xl font-medium mb-4">Tech Stack</h2>
    <div class="flex flex-wrap gap-4">
        {STACK.map(tech => (
            <div class="flex items-center gap-2 px-3 py-2 border rounded-lg bg-muted/30">
                <Icon name={tech.icon} class="size-5 text-primary" />
                <span class="text-sm font-medium">{tech.name}</span>
            </div>
        ))}
    </div>
</section>

---
import type { CollectionEntry } from "astro:content"

type Post = CollectionEntry<"blog">
type Props = { prev?: Post; next?: Post }

const { prev, next } = Astro.props
---

{(prev || next) && (
    <nav aria-label="More posts">
      <post-nav>
        {prev && (
          <a href={`/blog/${prev.id}`} data-dir="prev">
            <span>Previous</span>
            <strong>{prev.data.title}</strong>
          </a>
        )}
        {next && (
          <a href={`/blog/${next.id}`} data-dir="next">
            <span>Next</span>
            <strong>{next.data.title}</strong>
          </a>
        )}
      </post-nav>
    </nav>
  )}

<style>
  nav {
    margin-block-start: var(--space-xl);
  }

  post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-m);
    border-block-start: 1.5px solid var(--border);
    padding-block-start: var(--space-m);

    @media (width < 40rem) {
      grid-template-columns: 1fr;
    }
  }

  a {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    color: var(--foreground);
    text-decoration: none;

    &[data-dir="prev"] {
      grid-column: 1;
    }

    &[data-dir="next"] {
      grid-column: 2;
      text-align: end;
      align-items: flex-end;

      @media (width < 40rem) {
        grid-column: 1;
        text-align: start;
        align-items: flex-start;
      }
    }

    span {
      font-size: var(--step--1);
      color: var(--muted-foreground);
    }

    strong {
      font-size: var(--step-0);
      font-weight: var(--font-weight-medium);
      color: var(--foreground);
      text-decoration: none;
    }

    &:hover strong {
      color: var(--primary);
    }
  }
</style>

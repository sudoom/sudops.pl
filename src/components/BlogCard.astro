---
import { getSubposts } from "@/lib/content"
import { readingTime } from "@/lib/reading-time"
import { formatDate } from "@/lib/utils"
import { Image } from "astro:assets"
import { getEntries, type CollectionEntry } from "astro:content"

type Props = { post: CollectionEntry<"blog"> }

const { post } = Astro.props
const authors = await getEntries(post.data.authors)
const parts = (await getSubposts()).get(post.id) ?? []
const minutes = readingTime([post, ...parts])
---

<li>
  {post.data.image && (
      <a href={`/blog/${post.id}`} tabindex="-1" aria-hidden="true">
        <Image src={post.data.image} alt="" width={640} height={336} />
      </a>
    )}
  <entry-info>
    <a href={`/blog/${post.id}`}>{post.data.title}</a>
    <entry-meta>
      {authors.length > 0 && (
          <entry-authors>
            <author-avatars>
              {authors.map((author) => (
                <img
                  src={author.data.avatar}
                  alt={author.data.name}
                  width="18"
                  height="18"
                />
              ))}
            </author-avatars>
            <author-names>
              {authors.map((author, i) => (
                <>{i > 0 && ", "}{author.data.name}</>
              ))}
            </author-names>
          </entry-authors>
        )}
      <time datetime={post.data.date.toISOString()}
        >{formatDate(post.data.date)}</time
      >
      {parts.length > 0 && (
          <entry-parts
            >{parts.length} {parts.length === 1 ? "part" : "parts"}</entry-parts
          >
        )}
      <reading-time>{minutes} min read</reading-time>
    </entry-meta>
    <p>{post.data.description}</p>
  </entry-info>
</li>

<style>
  li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
      inline-size: 14rem;

      :global(img) {
        inline-size: 100%;
        block-size: auto;
      }
    }

    entry-info {
      display: flex;
      flex-direction: column;

      > a {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);

        &:hover {
          color: var(--primary);
        }
      }

      entry-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3xs);
        margin-block-end: var(--space-3xs);
        font-size: var(--step--1);
        color: var(--muted-foreground);

        entry-authors {
          display: flex;
          align-items: center;
          gap: var(--space-3xs);

          /* its flex gap already spaces the "·" */
          --separator-gap: 0;

          author-avatars {
            display: flex;
            margin-block-end: -0.1em;

            img {
              border-radius: var(--radius-full);
              box-shadow: 0 0 0 1.5px var(--background);

              &:not(:first-child) {
                margin-inline-start: -0.375rem;
              }
            }
          }
        }

        > :not(:last-child)::after {
          content: "·";
          margin-inline-start: var(--separator-gap, var(--space-3xs));
        }
      }

      p {
        color: var(--muted-foreground);
      }
    }

    @media (width < 40rem) {
      flex-direction: column;

      > a {
        inline-size: 100%;
        max-inline-size: 32rem;
      }
    }
  }
</style>

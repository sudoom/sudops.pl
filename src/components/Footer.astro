---
import { SOCIAL_LINKS } from '@/consts'
import SocialIcons from './SocialIcons.astro'
import Link from './Link.astro'
---

<footer
  class="mx-auto mb-8 flex w-full max-w-3xl flex-col items-center justify-center gap-y-3 px-4 sm:mb-4"
>
  <div class="flex items-center gap-x-3 text-xs text-muted-foreground">
    <Link href="/privacy" class="hover:text-primary transition-colors">Privacy Policy</Link>
    <span>·</span>
    <Link href="/terms" class="hover:text-primary transition-colors">Terms</Link>
  </div>
  <div class="flex w-full flex-col items-center justify-center gap-y-2 sm:flex-row sm:justify-between">
    <div class="flex flex-wrap items-center justify-center gap-x-2 text-center">
      <span class="text-muted-foreground text-sm">
        &copy; {new Date().getFullYear()} All rights reserved.
      </span>
    </div>
    <SocialIcons links={SOCIAL_LINKS} />
  </div>
</footer>
